# ============================================
# Backend Environment Configuration
# ============================================
# DATABASE_URL
#   - Development (SQLite, default):  sqlite:///./app.db
#   - Production / RDS (PostgreSQL):   postgresql://user:pass@host:5432/dbname
#
# Default is SQLite so you can run immediately without installing PostgreSQL.
# Set DATABASE_URL to your RDS endpoint for production.
DATABASE_URL=sqlite:///./app.db

# FastAPI host/port (dev default)
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# File storage (PDF attachments etc.)
#   - local : files stored on disk under LOCAL_STORAGE_DIR (dev/test/CI default)
#   - s3    : files stored in S3 bucket -- set S3_BUCKET (+ AWS credentials)
STORAGE_BACKEND=local
#S3_BUCKET=cs361-partner-docs
AWS_REGION=ap-southeast-1
# Optional static AWS credentials (.env is gitignored -- never commit real keys).
# Leave empty on EC2/IAM-role deployments.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./storage