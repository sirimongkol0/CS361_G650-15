# Local Docker Compose settings. These are development defaults, not secrets.
# Copy this file to .env only when you need to override a value.
POSTGRES_DB=pcsms
POSTGRES_USER=pcsms
POSTGRES_PASSWORD=pcsms_local_only
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
# This URL is embedded in the browser bundle, so it must be reachable from the
# host browser. If BACKEND_PORT changes, update this value to match.
PUBLIC_API_URL=http://localhost:8000/api/v1
