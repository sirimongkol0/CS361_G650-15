# Copy to .env.cstu and replace with a private random hexadecimal password.
# Keep the same password when reusing an existing CSTU database volume.
CSTU_DATABASE_PASSWORD=
CSTU_FRONTEND_PORT=3000
CSTU_BACKEND_PORT=8000

# Login (Amazon Cognito). IDs are not secrets; see infra/provision_cognito.py.
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
