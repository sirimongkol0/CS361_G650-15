node_modules/
dist/
build/
.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
.figma/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Backend runtime artifacts (local dev only)
backend/local.db
backend/venv/
backend/__pycache__/
backend/routers/__pycache__/
# storage/ holds real uploaded files (local storage backend, see backend/storage.py)
# -> ignore contents only, keep the directory via .gitkeep
backend/storage/*
!backend/storage/.gitkeep
backend/storage/agreements/

# Python bytecode
__pycache__/
*.pyc

# Private keys — never commit
*.pem

# Generated doc exports (regenerable from .md sources)
*.html
docs-th/*.docx
docs-th/**/*.docx

