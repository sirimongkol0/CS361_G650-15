# ============================================
# Frontend Environment Configuration
# ============================================
# Backend API URL for SERVER-SIDE fetches (SSR).
# - Running locally (npm run dev):  http://localhost:8000/api/v1
# - Inside Docker network: use the backend SERVICE NAME, e.g.
#   http://partner_activity_backend:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend API URL for BROWSER-SIDE links (download links, Swagger "/docs").
# The user's browser runs OUTSIDE the Docker network and cannot resolve
# Docker service names — always a host-reachable address here.
# Leave empty/absent to fall back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BROWSER_URL=http://localhost:8000/api/v1
